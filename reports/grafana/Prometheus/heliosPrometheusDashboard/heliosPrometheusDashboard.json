            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true,
              "Value #E": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "severity": true
            },
            "indexByName": {
              "cluster": 0,
              "health": 1,
              "version": 2,
              "patch": 3,
              "upgrade_status": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7,
              "alert_name": 8
            },
            "renameByName": {
              "cluster": "Cluster",
              "health": "Health",
              "version": "Version",
              "patch": "Latest Patch",
              "upgrade_status": "Upgrade Status",
              "Value #B": "Nodes",
              "Value #C": "Capacity %",
              "Value #D": "Total",
              "alert_name": "Latest Alert"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Cluster|Health|Version|Latest Patch|Upgrade Status|Nodes|Capacity %|Total|Latest Alert)$"
            }
          }
        }
