              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "UpToDate": {
                        "color": "green",
                        "index": 0,
                        "text": "Up To Date"
                      },
                      "UpgradeAvailable": {
                        "color": "blue",
                        "index": 1,
                        "text": "Upgrade Available"
                      },
                      "InProgress": {
                        "color": "blue",
                        "index": 2,
                        "text": "Upgrading"
                      },
                      "Scheduled": {
                        "color": "blue",
                        "index": 3,
                        "text": "Scheduled"
                      },
                      "Failed": {
                        "color": "red",
                        "index": 4,
                        "text": "Upgrade Failed"
                      },
                      "ClusterUnreachable": {
                        "color": "gray",
                        "index": 5,
                        "text": "Unreachable"
                      },
                      "": {
                        "color": "text-secondary",
                        "index": 6,
                        "text": "\u2013"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "text-secondary",
                        "index": 99,
                        "text": "\u2013"
