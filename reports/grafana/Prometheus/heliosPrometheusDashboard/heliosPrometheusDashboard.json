        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "applyToRow": false,
                  "type": "color-background",
                  "wrapText": false
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": {
                        "color": "green",
                        "index": 0,
                        "text": "Healthy"
                      },
                      "Critical": {
                        "color": "red",
                        "index": 1,
                        "text": "Critical"
                      },
                      "Disconnected": {
                        "color": "gray",
                        "index": 2,
                        "text": "Disconnected"
                      },
                      "Unknown": {
                        "color": "gray",
                        "index": 3,
                        "text": "Unknown"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "color": "text-secondary",
                        "index": 99,
                        "text": "\u2013"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Upgrade Status"
